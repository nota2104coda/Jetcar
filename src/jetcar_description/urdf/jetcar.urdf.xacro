<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="jetcar">

  <xacro:arg name="sim_mode" default="false"/>

  <!-- Material Definitions -->
  <material name="gray"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="blue"><color rgba="0.2 0.2 0.8 1"/></material>
  <material name="red"><color rgba="0.8 0.2 0.2 1"/></material>
  <material name="green"><color rgba="0.2 0.8 0.2 1"/></material>
  <material name="yellow"><color rgba="0.8 0.8 0.2 1"/></material>
  <material name="purple"><color rgba="0.6 0.2 0.8 1"/></material>

  <!-- Chassis (base_link) -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.25 0.13 0.004"/></geometry>
      <origin xyz="0 0 0.06"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry><box size="0.25 0.13 0.05"/></geometry>
      <origin xyz="0 0 0.07"/>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0.04"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.03"/>
    </inertial>
  </link>

  <!-- Wheels Macro -->
  <xacro:macro name="wheel" params="prefix x y">
    <link name="wheel_${prefix}">
      <visual>
        <geometry><cylinder length="0.03" radius="0.035"/></geometry>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><cylinder length="0.03" radius="0.035"/></geometry>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>
    <joint name="joint_wheel_${prefix}" type="continuous">
      <parent link="base_link"/>
      <child link="wheel_${prefix}"/>
      <origin xyz="${x} ${y} 0.035" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="fl" x="0.06" y="0.09"/>
  <xacro:wheel prefix="fr" x="0.06" y="-0.09"/>
  <xacro:wheel prefix="rl" x="-0.06" y="0.09"/>
  <xacro:wheel prefix="rr" x="-0.06" y="-0.09"/>

  <!-- Sensors & Accessories -->
  <link name="front_sonar"><visual><geometry><box size="0.03 0.07 0.03"/></geometry><origin xyz="0 0 0.06"/><material name="blue"/></visual></link>
  <joint name="joint_sr04_front" type="fixed"><parent link="base_link"/><child link="front_sonar"/><origin xyz="0.13 0 0.04"/></joint>

  <link name="rear_sonar"><visual><geometry><box size="0.03 0.07 0.03"/></geometry><origin xyz="0 0 0.06"/><material name="blue"/></visual></link>
  <joint name="joint_sr04_rear" type="fixed"><parent link="base_link"/><child link="rear_sonar"/><origin xyz="-0.13 0 0.04" rpy="0 0 3.14159"/></joint>

  <!-- Cliff Sensors -->
  <link name="cliff_front"><visual><geometry><box size="0.04 0.015 0.005"/></geometry><origin xyz="0 0 0.055"/><material name="red"/></visual></link>
  <joint name="joint_cliff_front" type="fixed"><parent link="base_link"/><child link="cliff_front"/><origin xyz="0.12 0.01 0.01"/></joint>
  
  <link name="cliff_rear"><visual><geometry><box size="0.04 0.015 0.005"/></geometry><origin xyz="0 0 0.055"/><material name="red"/></visual></link>
  <joint name="joint_cliff_rear" type="fixed"><parent link="base_link"/><child link="cliff_rear"/><origin xyz="-0.12 -0.01 0.01"/></joint>

  <!-- Camera -->
  <link name="camera_binoc"><visual><geometry><box size="0.025 0.10 0.02"/></geometry><origin xyz="0 0 0.06"/><material name="green"/></visual></link>
  <joint name="joint_camera_binoc" type="fixed"><parent link="base_link"/><child link="camera_binoc"/><origin xyz="0.06 -0.01 0.13"/></joint>

  <link name="camera_link"/>
  <joint name="joint_camera_link" type="fixed"><parent link="camera_binoc"/><child link="camera_link"/><origin xyz="0 0 0"/></joint>

  <!-- Logical Frames for RealSense -->
  <link name="camera_depth_frame"/>
  <joint name="joint_camera_depth_frame" type="fixed"><parent link="camera_link"/><child link="camera_depth_frame"/><origin xyz="0 0 0"/></joint>
  <link name="camera_depth_optical_frame"/>
  <joint name="joint_camera_depth_optical_frame" type="fixed"><parent link="camera_depth_frame"/><child link="camera_depth_optical_frame"/><origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/></joint>
  
  <link name="camera_infra1_frame"/>
  <joint name="joint_camera_infra1_frame" type="fixed"><parent link="camera_link"/><child link="camera_infra1_frame"/><origin xyz="0 0 0"/></joint>
  <link name="camera_infra1_optical_frame"/>
  <joint name="joint_camera_infra1_optical_frame" type="fixed"><parent link="camera_infra1_frame"/><child link="camera_infra1_optical_frame"/><origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/></joint>

  <link name="camera_infra2_frame"/>
  <joint name="joint_camera_infra2_frame" type="fixed"><parent link="camera_link"/><child link="camera_infra2_frame"/><origin xyz="0 0 0"/></joint>
  <link name="camera_infra2_optical_frame"/>
  <joint name="joint_camera_infra2_optical_frame" type="fixed"><parent link="camera_infra2_frame"/><child link="camera_infra2_optical_frame"/><origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/></joint>

  <!-- Lidar & Other Sensors -->
  <link name="ld06_lidar"><visual><geometry><cylinder length="0.015" radius="0.02"/></geometry><material name="purple"/></visual><inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="joint_ld06" type="fixed"><parent link="base_link"/><child link="ld06_lidar"/><origin xyz="0.02 0.0 0.18" rpy="0 0 -1.5708"/></joint>

  <link name="imu_link"><visual><geometry><box size="0.02 0.02 0.01"/></geometry><material name="blue"/></visual><inertial><mass value="0.01"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial></link>
  <joint name="joint_imu" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0.1 0.01"/></joint>

  <!-- ToF & Radar (Visuals only) -->
  <link name="vl53l5x_front"><visual><geometry><box size="0.01 0.02 0.01"/></geometry><origin xyz="0 0 0.06"/><material name="yellow"/></visual></link>
  <joint name="joint_vl53l5x_front" type="fixed"><parent link="base_link"/><child link="vl53l5x_front"/><origin xyz="0.13 0 0.045"/></joint>

  <link name="ld2450_front"><visual><geometry><box size="0.005 0.015 0.05"/></geometry><origin xyz="0 0 0.06"/><material name="purple"/></visual></link>
  <joint name="joint_ld2450_front" type="fixed"><parent link="base_link"/><child link="ld2450_front"/><origin xyz="0.1 0.03 0.05"/></joint>

  <!-- Simulation Specific Tags -->
  <xacro:if value="$(arg sim_mode)">
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
      <joint name="joint_wheel_fl"><command_interface name="effort"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
      <joint name="joint_wheel_fr"><command_interface name="effort"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
      <joint name="joint_wheel_rl"><command_interface name="effort"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
      <joint name="joint_wheel_rr"><command_interface name="effort"/><state_interface name="position"/><state_interface name="velocity"/><state_interface name="effort"/></joint>
    </ros2_control>

    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlSystem">
        <parameters>$(find jetcar_sim)/config/sim_controllers.yaml</parameters>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>odom</odom_frame>
        <robot_base_frame>base_link</robot_base_frame>
        <odom_publish_frequency>50</odom_publish_frequency>
      </plugin>
    </gazebo>

    <gazebo reference="camera_binoc">
      <sensor name="camera" type="rgbd">
        <gz_frame_id>camera_binoc</gz_frame_id>
        <update_rate>15</update_rate>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>10.0</far></clip>
        </camera>
      </sensor>
    </gazebo>

    <gazebo reference="ld06_lidar">
      <sensor name="ld06_lidar" type="gpu_lidar">
        <gz_frame_id>ld06_lidar</gz_frame_id>
        <update_rate>10</update_rate>
        <lidar>
          <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
          <range><min>0.1</min><max>12.0</max></range>
        </lidar>
      </sensor>
    </gazebo>

    <gazebo reference="imu_link">
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>imu_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
      </sensor>
    </gazebo>

    <gazebo reference="wheel_fl"><mu>1.0</mu><mu2>1.0</mu2></gazebo>
    <gazebo reference="wheel_fr"><mu>1.0</mu><mu2>1.0</mu2></gazebo>
    <gazebo reference="wheel_rl"><mu>1.0</mu><mu2>1.0</mu2></gazebo>
    <gazebo reference="wheel_rr"><mu>1.0</mu><mu2>1.0</mu2></gazebo>
  </xacro:if>

</robot>
