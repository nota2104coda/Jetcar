<?xml version="1.0"?>
<robot name="skid_steer_4wd">
  <!-- Chassis -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.30 0.20 0.08"/>
      </geometry>
      <origin xyz="0 0 0.04"/>
      <material name="gray">
        <color rgba="0.6 0.6 0.6 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.30 0.20 0.08"/>
      </geometry>
      <origin xyz="0 0 0.04"/>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0.04"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.03"/>
    </inertial>
  </link>

  <!-- Wheels (FL, FR, RL, RR) -->
  <link name="wheel_fl">
    <visual>
      <geometry>
        <cylinder length="0.03" radius="0.035"/>
      </geometry>
      <origin xyz="0.11 0.09 0.035" rpy="0 1.5708 0"/>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
  </link>
  <link name="wheel_fr">
    <visual>
      <geometry>
        <cylinder length="0.03" radius="0.035"/>
      </geometry>
      <origin xyz="0.11 -0.09 0.035" rpy="0 1.5708 0"/>
      <material name="black"/>
    </visual>
  </link>
  <link name="wheel_rl">
    <visual>
      <geometry>
        <cylinder length="0.03" radius="0.035"/>
      </geometry>
      <origin xyz="-0.11 0.09 0.035" rpy="0 1.5708 0"/>
      <material name="black"/>
    </visual>
  </link>
  <link name="wheel_rr">
    <visual>
      <geometry>
        <cylinder length="0.03" radius="0.035"/>
      </geometry>
      <origin xyz="-0.11 -0.09 0.035" rpy="0 1.5708 0"/>
      <material name="black"/>
    </visual>
  </link>

  <!-- Wheel joints -->
  <joint name="joint_wheel_fl" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fl"/>
    <origin xyz="0.11 0.09 0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="joint_wheel_fr" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_fr"/>
    <origin xyz="0.11 -0.09 0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="joint_wheel_rl" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rl"/>
    <origin xyz="-0.11 0.09 0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>
  <joint name="joint_wheel_rr" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rr"/>
    <origin xyz="-0.11 -0.09 0.035" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- SR04 Sonar (rear) -->
  <link name="sr04_rear">
    <visual>
      <geometry>
        <box size="0.03 0.01 0.01"/>
      </geometry>
      <origin xyz="-0.15 0 0.04"/>
      <material name="blue">
        <color rgba="0.2 0.2 0.8 1"/>
      </material>
    </visual>
  </link>
  <joint name="joint_sr04_rear" type="fixed">
    <parent link="base_link"/>
    <child link="sr04_rear"/>
    <origin xyz="-0.15 0 0.04"/>
  </joint>

  <!-- Cliff sensors (front/rear) -->
  <link name="cliff_front">
    <visual>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <origin xyz="0.15 0.06 0.01"/>
      <material name="red">
        <color rgba="0.8 0.2 0.2 1"/>
      </material>
    </visual>
  </link>
  <joint name="joint_cliff_front" type="fixed">
    <parent link="base_link"/>
    <child link="cliff_front"/>
    <origin xyz="0.15 0.06 0.01"/>
  </joint>
  <link name="cliff_rear">
    <visual>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <origin xyz="-0.15 -0.06 0.01"/>
      <material name="red"/>
    </visual>
  </link>
  <joint name="joint_cliff_rear" type="fixed">
    <parent link="base_link"/>
    <child link="cliff_rear"/>
    <origin xyz="-0.15 -0.06 0.01"/>
  </joint>

  <!-- Camera (front) -->
  <link name="camera_front">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.03"/>
      </geometry>
      <origin xyz="0.15 0 0.08"/>
      <material name="green">
        <color rgba="0.2 0.8 0.2 1"/>
      </material>
    </visual>
  </link>
  <joint name="joint_camera_front" type="fixed">
    <parent link="base_link"/>
    <child link="camera_front"/>
    <origin xyz="0.15 0 0.08"/>
  </joint>

  <!-- VL53L5X (front ToF array) -->
  <link name="vl53l5x_front">
    <visual>
      <geometry>
        <box size="0.02 0.02 0.01"/>
      </geometry>
      <origin xyz="0.15 0 0.06"/>
      <material name="yellow">
        <color rgba="0.8 0.8 0.2 1"/>
      </material>
    </visual>
  </link>
  <joint name="joint_vl53l5x_front" type="fixed">
    <parent link="base_link"/>
    <child link="vl53l5x_front"/>
    <origin xyz="0.15 0 0.06"/>
  </joint>

  <!-- LD2450 (front radar) -->
  <link name="ld2450_front">
    <visual>
      <geometry>
        <box size="0.03 0.02 0.01"/>
      </geometry>
      <origin xyz="0.15 0 0.05"/>
      <material name="purple">
        <color rgba="0.6 0.2 0.8 1"/>
      </material>
    </visual>
  </link>
  <joint name="joint_ld2450_front" type="fixed">
    <parent link="base_link"/>
    <child link="ld2450_front"/>
    <origin xyz="0.15 0 0.05"/>
  </joint>
</robot>
