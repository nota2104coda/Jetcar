<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="jetcar_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.8 0.8 0.8 1</specular></material>
        </visual>
      </link>
    </model>

    <!-- Simple Room Walls (5x5m) -->
    <model name="wall_front">
      <static>true</static><pose>2.5 0 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.1 5.0 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 5.0 1.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.1 0.1 0.7 1</diffuse></material></visual></link>
    </model>
    <model name="wall_back">
      <static>true</static><pose>-2.5 0 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.1 5.0 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 5.0 1.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.3 0.1 0.5 1</diffuse></material></visual></link>
    </model>
    <model name="wall_left">
      <static>true</static><pose>0 2.5 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>5.0 0.1 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>5.0 0.1 1.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.5 0.1 0.3 1</diffuse></material></visual></link>
    </model>
    <model name="wall_right">
      <static>true</static><pose>0 -2.5 0.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>5.0 0.1 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>5.0 0.1 1.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.1 0.7 1</diffuse></material></visual></link>
    </model>

    <!-- Obstacles -->
    <model name="box1"><static>true</static><pose>1.0 1.0 0.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.5 0.5 0.5</size></box></geometry><material><ambient>1 0 0 1</ambient><diffuse>0.2 0.6 0 1</diffuse></material></visual></link>
    </model>
    <model name="cylinder1"><static>true</static><pose>-1.0 -1.0 0.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.3</radius><length>0.5</length></cylinder></geometry><material><ambient>0 1 0 1</ambient><diffuse>0 1 0.4 1</diffuse></material></visual></link>
    </model>

  </world>
</sdf>
