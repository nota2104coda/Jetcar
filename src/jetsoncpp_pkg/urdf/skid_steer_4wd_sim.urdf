<?xml version="1.0"?>
<robot name="skid_steer_4wd_sim">
  <!-- Material Definitions -->
  <material name="gray"><color rgba="0.6 0.6 0.6 1"/></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1"/></material>

  <!-- Chassis -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.25 0.13 0.06"/></geometry>
      <origin xyz="0 0 0.06"/>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry><box size="0.30 0.20 0.13"/></geometry>
      <origin xyz="0 0 0.06"/>
    </collision>
    <inertial>
      <mass value="5.0"/>
      <origin xyz="0 0 0.04"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <!-- Wheel Helper -->
  <link name="wheel_fl">
    <visual><geometry><cylinder length="0.03" radius="0.035"/></geometry><origin xyz="0 0 0" rpy="1.5708 0 0"/><material name="black"/></visual>
    <collision><geometry><cylinder length="0.03" radius="0.035"/></geometry><origin xyz="0 0 0" rpy="1.5708 0 0"/></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <link name="wheel_fr">
    <visual><geometry><cylinder length="0.03" radius="0.035"/></geometry><origin xyz="0 0 0" rpy="1.5708 0 0"/><material name="black"/></visual>
    <collision><geometry><cylinder length="0.03" radius="0.035"/></geometry><origin xyz="0 0 0" rpy="1.5708 0 0"/></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <link name="wheel_rl">
    <visual><geometry><cylinder length="0.03" radius="0.035"/></geometry><origin xyz="0 0 0" rpy="1.5708 0 0"/><material name="black"/></visual>
    <collision><geometry><cylinder length="0.03" radius="0.035"/></geometry><origin xyz="0 0 0" rpy="1.5708 0 0"/></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <link name="wheel_rr">
    <visual><geometry><cylinder length="0.03" radius="0.035"/></geometry><origin xyz="0 0 0" rpy="1.5708 0 0"/><material name="black"/></visual>
    <collision><geometry><cylinder length="0.03" radius="0.035"/></geometry><origin xyz="0 0 0" rpy="1.5708 0 0"/></collision>
    <inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <joint name="joint_wheel_fl" type="continuous"><parent link="base_link"/><child link="wheel_fl"/><origin xyz="0.06 0.09 0.035"/><axis xyz="0 1 0"/></joint>
  <joint name="joint_wheel_fr" type="continuous"><parent link="base_link"/><child link="wheel_fr"/><origin xyz="0.06 -0.09 0.035"/><axis xyz="0 1 0"/></joint>
  <joint name="joint_wheel_rl" type="continuous"><parent link="base_link"/><child link="wheel_rl"/><origin xyz="-0.06 0.09 0.035"/><axis xyz="0 1 0"/></joint>
  <joint name="joint_wheel_rr" type="continuous"><parent link="base_link"/><child link="wheel_rr"/><origin xyz="-0.06 -0.09 0.035"/><axis xyz="0 1 0"/></joint>

  <!-- Simulated Camera Link -->
  <link name="camera_link_sim"><inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="joint_camera_sim" type="fixed"><parent link="base_link"/><child link="camera_link_sim"/><origin xyz="0.1 0 0.15" rpy="0 0 0"/></joint>
  <!-- RealSense optical frames (matching your existing URDF for software compatibility) -->
  <link name="camera_depth_optical_frame"/>
  <joint name="joint_depth_optical" type="fixed"><parent link="camera_link_sim"/><child link="camera_depth_optical_frame"/><origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/></joint>

  <!-- Lidar -->
  <link name="ld06_lidar"><inertial><mass value="0.1"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="joint_ld06" type="fixed"><parent link="base_link"/><child link="ld06_lidar"/><origin xyz="0.02 0.0 0.18" rpy="0 0 0"/></joint>

  <!-- GAZEBO PLUGINS -->
  <gazebo>
    <plugin name="skid_steer_drive" filename="libgazebo_ros_diff_drive.so">
      <ros><remapping>cmd_vel:=cmd_vel</remapping><remapping>odom:=odom</remapping></ros>
      <update_rate>50</update_rate>
      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>joint_wheel_fl</left_joint><left_joint>joint_wheel_rl</left_joint>
      <right_joint>joint_wheel_fr</right_joint><right_joint>joint_wheel_rr</right_joint>
      <wheel_separation>0.18</wheel_separation>
      <wheel_diameter>0.07</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <gazebo reference="camera_link_sim">
    <sensor name="camera" type="depth">
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.204</horizontal_fov>
        <image><width>640</width><height>480</height><format>B8G8R8</format></image>
        <clip><near>0.1</near><far>10.0</far></clip>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>camera</namespace>
          <remapping>camera/image_raw:=camera/color/image_raw</remapping>
          <remapping>camera/depth/image_raw:=camera/depth/image_rect_raw</remapping>
          <remapping>camera/camera_info:=camera/color/camera_info</remapping>
          <remapping>camera/depth/camera_info:=camera/depth/camera_info</remapping>
        </ros>
        <frame_name>camera_depth_optical_frame</frame_name>
        <min_depth>0.1</min_depth>
        <max_depth>10.0</max_depth>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="ld06_lidar">
    <sensor name="ld06_lidar" type="ray">
      <update_rate>10</update_rate>
      <ray>
        <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan>
        <range><min>0.1</min><max>12.0</max></range>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>ld06_lidar</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
