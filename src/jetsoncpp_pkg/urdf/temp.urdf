<?xml version="1.0"?>

<robot name="robot_name">

<!-- Base Link -->

<link name="base_link">
<!-- Define shape, size, and collision properties -->
</link>

<!-- Joints and Wheel Links -->

<!-- Joint for Front Left Wheel -->

<joint name="wheel_joint_fl" type="continuous">
<parent link="base_link"/>
<child link="wheel_fl_link"/>
<origin xyz="0.1 0.1 0" rpy="0 0 0"/>
<axis xyz="0 1 0"/>
</joint>
<link name="wheel_fl_link">
<!-- Define wheel properties -->
</link>

<!-- Joint for Front Right Wheel -->

<joint name="wheel_joint_fr" type="continuous">
<parent link="base_link"/>
<child link="wheel_fr_link"/>
<origin xyz="0.1 -0.1 0" rpy="0 0 0"/>
<axis xyz="0 1 0"/>
</joint>
<link name="wheel_fr_link">
<!-- Define wheel properties -->
</link>

<!-- Joint for Back Left Wheel -->

<joint name="wheel_joint_bl" type="continuous">
<parent link="base_link"/>
<child link="wheel_bl_link"/>
<origin xyz="-0.1 0.1 0" rpy="0 0 0"/>
<axis xyz="0 1 0"/>
</joint>
<link name="wheel_bl_link">
<!-- Define wheel properties -->
</link>

<!-- Joint for Back Right Wheel -->

<joint name="wheel_joint_br" type="continuous">
<parent link="base_link"/>
<child link="wheel_br_link"/>
<origin xyz="-0.1 -0.1 0" rpy="0 0 0"/>
<axis xyz="0 1 0"/>
</joint>
<link name="wheel_br_link">
<!-- Define wheel properties -->
</link>

<!-- Camera Pan Joint and Link -->

<joint name="pan_joint" type="revolute">
<parent link="base_link"/>
<child link="pan_link"/>
<!-- Position of the pan joint on the base -->
<origin xyz="0.2 0 0.1" rpy="0 0 0"/>
<!-- Pan axis is Z -->
<axis xyz="0 0 1"/>
<!-- Define the range of motion for the servo -->
<limit lower="-pi/2"upper="{pi/2}" effort="10" velocity="10"/>
</joint>
<link name="pan_link">
<!-- Define pan servo properties -->
</link>

<!-- Camera Tilt Joint and Link -->

<joint name="tilt_joint" type="revolute">
<parent link="pan_link"/>
<child link="tilt_link"/>
<!-- Position of the tilt joint relative to the pan link -->
<origin xyz="0 0 0" rpy="0 0 0"/>
<!-- Tilt axis is Y -->
<axis xyz="0 1 0"/>
<!-- Define the range of motion for the servo -->
<limit lower="-pi/4"upper="{pi/4}" effort="10" velocity="10"/>
</joint>
<link name="tilt_link">
<!-- Define tilt servo properties -->
</link>

<!-- Camera Link (fixed to the tilt link) -->

<joint name="camera_fixed_joint" type="fixed">
<parent link="tilt_link"/>
<child link="camera_link"/>
<origin xyz="0 0 0" rpy="0 0 0"/>
</joint>
<link name="camera_link">
<!-- Define camera properties -->
</link>

<!-- Ultrasonic Sensor Link -->

<joint name="ultrasonic_joint" type="fixed">
<parent link="base_link"/>
<child link="ultrasonic_link"/>
<origin xyz="0.2 0 0.05" rpy="0 0 0"/>
</joint>
<link name="ultrasonic_link">
<!-- Define sensor properties -->
</link>

<!-- Cliff Sensor Link -->

<joint name="cliff_joint" type="fixed">
<parent link="base_link"/>
<child link="cliff_link"/>
<origin xyz="0.1 0 -0.05" rpy="0 0 0"/>
</joint>
<link name="cliff_link">
<!-- Define sensor properties -->
</link>
</robot>