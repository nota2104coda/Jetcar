# Dockerfile for Pi5 (ARM64) using a multi-stage build.

# --- Stage 1: Base Image ---
# This stage is defined in Dockerfile.pi5.base and is built by docker-compose.
# We will use a single-stage Dockerfile here that builds on the base image.
# This approach is cleaner when using docker-compose to manage build dependencies.
FROM ros:kilted-ros-core as base

WORKDIR /workspace

RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-venv \
    python3-colcon-common-extensions \
    python3-opencv \
	ros-kilted-rosidl-default-generators \
	ros-kilted-teleop-twist-keyboard \
    && rm -rf /var/lib/apt/lists/*

COPY docker/requirements.txt /workspace/requirements.txt
RUN python3.11 -m pip install --no-cache-dir -r /workspace/requirements.txt

# Copy application code
COPY . .

# Create non-root user for security (optional but recommended)
RUN useradd -m -u 1000 robot && chown -R robot:robot /workspace
USER robot

# Set up the ROS2 workspace
RUN . /opt/ros/kilted/setup.sh && colcon build
